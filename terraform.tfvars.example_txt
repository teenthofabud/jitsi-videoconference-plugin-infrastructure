project_name = "jitsi"
environment  = "dev"
aws_region   = "us-east-1"

deployments = {
  dev = {
    us-east-1 = {
      features = {
        jitsi_web       = true
        jitsi_vpc       = false
        jitsi_bitwarden = false
      }

      jitsi_web = {
        index_document        = "index.html"
        error_document        = "error.html"
        force_destroy         = true
        enable_versioning     = false
        enable_website        = true
        enable_public_read    = true
        prevent_destroy       = false
        create_before_destroy = true
        ignore_changes        = []

        tags = {
          Component = "jitsi-web"
        }
      }

      jitsi_vpc = {
        vpc = {
          cidr = "10.0.0.0/16"
          tag  = "jitsi-prod-vpc"
        }

        subnet = {
          cidr = "10.0.1.0/24"
          tags = {
            Component = "jitsi-subnet"
          }
        }

        gateway_endpoint = {
          service_name    = "s3"
          route_table_ids = []
          tags = {
            Component = "jitsi-gateway-endpoint"
          }
        }
      }

      jitsi_bitwarden = {
        org_id = "your-bitwarden-org-id"
      }
    }
  }

  prod = {
    us-east-1 = {
      features = {
        jitsi_web       = true
        jitsi_vpc       = true
        jitsi_bitwarden = true
      }

      jitsi_web = {
        index_document        = "index.html"
        error_document        = "error.html"
        force_destroy         = false
        enable_versioning     = true
        enable_website        = true
        enable_public_read    = false
        prevent_destroy       = true
        create_before_destroy = true
        ignore_changes        = []

        tags = {
          Component = "jitsi-web"
        }
      }

      jitsi_vpc = {
        vpc = {
          cidr = "10.0.0.0/16"
          tag  = "jitsi-prod-vpc"
        }

        subnet = {
          cidr = "10.0.1.0/24"
          tags = {
            Component = "jitsi-subnet"
          }
        }

        gateway_endpoint = {
          service_name    = "s3"
          route_table_ids = []
          tags = {
            Component = "jitsi-gateway-endpoint"
          }
        }
      }

      jitsi_bitwarden = {
        org_id = "your-bitwarden-org-id"
      }
    }
  }
}
